<?xml version="1.0" encoding="utf-8"?>
<!--
    actividad_inscripcion_views.xml
    ================================
    Vistas para el modelo actividad.inscripcion cuando se accede de forma
    independiente (ej. desde un smart button o menú de gestión).
-->
<odoo>
    <!-- ================================================================ -->
    <!-- VISTA LISTA                                                       -->
    <!-- ================================================================ -->
    <record id="view_actividad_inscripcion_list" model="ir.ui.view">
        <field name="name">actividad.inscripcion.list</field>
        <field name="model">actividad.inscripcion</field>
        <field name="arch" type="xml">
            <list
                string="Evaluación de Desempeño"
                create="0"
                delete="0"
                decoration-success="certificate_generated"
                decoration-muted="performance_level == '0' or not performance_level"
            >
                <field name="partner_id" string="Estudiante" readonly="1"/>
                <field name="performance_level"
                    widget="selection"
                    decoration-danger="performance_level == '0'"
                    decoration-warning="performance_level == '1'"
                    decoration-info="performance_level == '2'"
                    decoration-success="performance_level in ('3','4')"
                />
                <field name="observations" string="Observaciones" readonly="1"/>
                <field name="certificate_generated" readonly="1"/>
                <field name="certificate_signed" readonly="1"/>
                <button name="action_evaluar" string="Evaluar"
                        type="object" icon="fa-pencil" class="btn-sm btn-primary"/>
            </list>
        </field>
    </record>

    <record id="action_actividad_inscripcion" model="ir.actions.act_window">
        <field name="name">Evaluación de Desempeño</field>
        <field name="res_model">actividad.inscripcion</field>
        <field name="view_mode">list</field>
        <field name="views">[(ref('view_actividad_inscripcion_list'), 'list')]</field>
    </record>

</odoo>