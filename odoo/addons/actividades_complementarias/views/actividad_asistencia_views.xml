<?xml version="1.0" encoding="utf-8"?>
<!--
    actividad_asistencia_views.xml
    ================================
    La vista matricial (pase de lista por fecha/columna) se define en
    actividad_pase_lista_pivot_views.xml y su lógica en pase_lista_pivot.js.

    Este archivo conserva solo la acción de ventana legacy para que las
    referencias externas al modelo actividad.asistencia sigan funcionando.
-->
<odoo>
    <!-- Acción de ventana de respaldo (usada por menús administrativos) -->
    <record id="action_actividad_asistencia" model="ir.actions.act_window">
        <field name="name">Pase de Lista</field>
        <field name="res_model">actividad.asistencia</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="actividades_complementarias.view_actividad_asistencia_list"/>
    </record>
</odoo>
