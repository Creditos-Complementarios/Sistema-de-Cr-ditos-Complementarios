<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_solicitud_liberacion_list" model="ir.ui.view">
        <field name="name">actividad.solicitud.liberacion.list</field>
        <field name="model">actividad.solicitud.liberacion</field>
        <field name="arch" type="xml">
            <list string="Expediente de Créditos Complementarios">
                <field name="fecha"/>
                <field name="creditos_validos" string="Créditos Válidos"/>
                <field name="promedio_label" string="Nivel de Desempeño"/>
                <field name="estado" widget="badge"
                    decoration-muted="estado == 'borrador'"
                    decoration-warning="estado == 'en_revision'"
                    decoration-success="estado == 'aprobada'"
                    decoration-danger="estado == 'rechazada'"/>
            </list>
        </field>
    </record>

    <record id="view_solicitud_liberacion_form" model="ir.ui.view">
        <field name="name">actividad.solicitud.liberacion.form</field>
        <field name="model">actividad.solicitud.liberacion</field>
        <field name="arch" type="xml">
            <form string="Expediente de Créditos Complementarios" create="0">
                <header>
                    <!-- Paso 6 flujo: botón habilitado solo si puede_solicitar -->
                    <button name="action_solicitar_liberacion"
                            string="Solicitar Liberación"
                            type="object" class="btn-primary"
                            invisible="estado != 'borrador' or not puede_solicitar"/>
                    <field name="estado" widget="statusbar"
                           statusbar_visible="borrador,en_revision,aprobada,rechazada"
                           readonly="1"/>
                </header>
                <sheet>
                    <field name="puede_solicitar" invisible="1"/>
                    <field name="razon_bloqueado" invisible="1"/>

                    <!-- Alerta: no cumple RN2 o RN3 -->
                    <div class="alert alert-warning" role="alert"
                         invisible="puede_solicitar or estado != 'borrador'">
                        <i class="fa fa-exclamation-triangle me-1"/>
                        <strong>No puedes solicitar la liberación: </strong>
                        <field name="razon_bloqueado" nolabel="1" readonly="1"/>
                    </div>

                    <!-- Aprobada: liberación completa -->
                    <div class="alert alert-success" role="alert"
                         invisible="estado != 'aprobada'">
                        <i class="fa fa-check-circle me-1"/>
                        <strong>¡Liberación aprobada!</strong>
                        Tus actividades complementarias han sido liberadas.
                    </div>

                    <!-- Rechazada: flujo alterno RN3 — puede crear nueva -->
                    <div class="alert alert-info" role="alert"
                         invisible="estado != 'rechazada'">
                        <i class="fa fa-info-circle me-1"/>
                        Tu solicitud fue rechazada. Puedes crear una
                        <strong>nueva solicitud</strong> desde el listado si
                        aún cumples con los requisitos.
                    </div>

                    <group>
                        <group string="Datos del Estudiante">
                            <field name="estudiante_id" readonly="1"/>
                            <field name="fecha" readonly="1"/>
                        </group>
                        <group string="Resumen de Créditos">
                            <field name="creditos_validos" readonly="1"/>
                            <field name="promedio_desempenio" readonly="1"
                                   digits="[4,2]"/>
                            <field name="promedio_label"
                                   string="Nivel" readonly="1"/>
                        </group>
                    </group>

                    <div class="alert alert-light border" role="alert"
                         invisible="estado != 'borrador'">
                        <i class="fa fa-info-circle me-1"/>
                        Consulta tus <strong>constancias acreditadas</strong>
                        en el menú <em>Mis Constancias</em>.
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Vista SE: lista de solicitudes para revisar ── -->
    <record id="view_solicitud_liberacion_se_list" model="ir.ui.view">
        <field name="name">actividad.solicitud.liberacion.se.list</field>
        <field name="model">actividad.solicitud.liberacion</field>
        <field name="arch" type="xml">
            <list string="Solicitudes de Liberación" create="0">
                <field name="estudiante_id" string="Estudiante"/>
                <field name="fecha"/>
                <field name="creditos_validos" string="Créditos"/>
                <field name="promedio_label" string="Desempeño"/>
                <field name="ventana_id" string="Ventana"/>
                <field name="estado" widget="badge"
                    decoration-warning="estado == 'en_revision'"
                    decoration-success="estado == 'aprobada'"
                    decoration-danger="estado == 'rechazada'"
                    decoration-muted="estado == 'borrador'"/>
            </list>
        </field>
    </record>

    <!-- ── Vista SE: formulario con acciones de aprobación ── -->
    <record id="view_solicitud_liberacion_se_form" model="ir.ui.view">
        <field name="name">actividad.solicitud.liberacion.se.form</field>
        <field name="model">actividad.solicitud.liberacion</field>
        <field name="arch" type="xml">
            <form string="Solicitud de Liberación" create="0">
                <header>
                    <button name="action_aprobar_se" string="Aprobar"
                            type="object" class="btn-success"
                            invisible="estado != 'en_revision'"
                            confirm="¿Confirmar la aprobación de esta solicitud?"/>
                    <button name="action_rechazar_se" string="Rechazar"
                            type="object" class="btn-danger"
                            invisible="estado != 'en_revision'"/>
                    <field name="estado" widget="statusbar"
                        statusbar_visible="borrador,en_revision,aprobada,rechazada"
                        readonly="1"/>
                </header>
                <sheet>
                    <group>
                        <group string="Datos del Estudiante">
                            <field name="estudiante_id" readonly="1"/>
                            <field name="fecha" readonly="1"/>
                            <field name="ventana_id" readonly="1"/>
                        </group>
                        <group string="Resumen de Créditos">
                            <field name="creditos_validos" readonly="1"/>
                            <field name="promedio_desempenio" readonly="1"/>
                            <field name="promedio_label" string="Nivel" readonly="1"/>
                        </group>
                    </group>
                    <group string="Resolución" invisible="estado == 'borrador'">
                        <field name="aprobado_por" readonly="1"
                            invisible="estado == 'en_revision'"/>
                        <field name="observaciones_se"
                            readonly="estado not in ['en_revision']"
                            placeholder="Obligatorio al rechazar..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Búsqueda SE con filtros por estado -->
    <record id="view_solicitud_liberacion_se_search" model="ir.ui.view">
        <field name="name">actividad.solicitud.liberacion.se.search</field>
        <field name="model">actividad.solicitud.liberacion</field>
        <field name="arch" type="xml">
            <search string="Buscar Solicitudes">
                <field name="estudiante_id" string="Estudiante"/>
                <filter name="filter_pendientes" string="Pendientes"
                        domain="[('estado','=','en_revision')]"/>
                <filter name="filter_aprobadas" string="Aprobadas"
                        domain="[('estado','=','aprobada')]"/>
                <filter name="filter_rechazadas" string="Rechazadas"
                        domain="[('estado','=','rechazada')]"/>
                <separator/>
                <filter name="group_ventana" string="Por Ventana"
                        context="{'group_by':'ventana_id'}"/>
            </search>
        </field>
    </record>

    <!-- Acción SE: solicitudes de la ventana activa (filtro automático pendientes) -->
    <record id="action_solicitud_liberacion_se" model="ir.actions.act_window">
        <field name="name">Solicitudes de Liberación</field>
        <field name="res_model">actividad.solicitud.liberacion</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('estado', '!=', 'borrador')]</field>
        <field name="context">{'search_default_filter_pendientes': 1}</field>
        <field name="search_view_id" ref="view_solicitud_liberacion_se_search"/>
        <field name="views" eval="[
            (ref('view_solicitud_liberacion_se_list'), 'list'),
            (ref('view_solicitud_liberacion_se_form'), 'form'),
        ]"/>
    </record>

    <!-- Acción SE: historial (aprobadas y rechazadas de periodos anteriores) -->
    <record id="action_historial_solicitudes_se" model="ir.actions.act_window">
        <field name="name">Historial de Solicitudes</field>
        <field name="res_model">actividad.solicitud.liberacion</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('estado', 'in', ['aprobada', 'rechazada'])]</field>
        <field name="search_view_id" ref="view_solicitud_liberacion_se_search"/>
        <field name="views" eval="[
            (ref('view_solicitud_liberacion_se_list'), 'list'),
            (ref('view_solicitud_liberacion_se_form'), 'form'),
        ]"/>
    </record>

    <!-- SE-03SC: consulta de estudiante por No. Control / nombre -->
    <record id="view_sii_estudiante_se_list" model="ir.ui.view">
        <field name="name">sii.estudiante.se.list</field>
        <field name="model">sii.estudiante</field>
        <field name="arch" type="xml">
            <list string="Estudiantes" create="0" edit="0" delete="0">
                <field name="no_control" string="No. Control"/>
                <field name="nombre"/>
                <field name="apellido_paterno"/>
                <field name="apellido_materno"/>
                <field name="id_carrera" string="Carrera"/>
                <field name="semestre"/>
                <field name="estado_estudiante" string="Estado"/>
            </list>
        </field>
    </record>

    <record id="view_sii_estudiante_se_form" model="ir.ui.view">
        <field name="name">sii.estudiante.se.form</field>
        <field name="model">sii.estudiante</field>
        <field name="arch" type="xml">
            <form string="Expediente del Estudiante" create="0" edit="0" delete="0">
                <sheet>
                    <group string="Datos Generales">
                        <field name="no_control" readonly="1"/>
                        <field name="nombre" readonly="1"/>
                        <field name="apellido_paterno" readonly="1"/>
                        <field name="apellido_materno" readonly="1"/>
                        <field name="id_carrera" readonly="1"/>
                        <field name="semestre" readonly="1"/>
                        <field name="grupo" readonly="1"/>
                        <field name="estado_estudiante" readonly="1"/>
                        <field name="correo" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sii_estudiante_se_search" model="ir.ui.view">
        <field name="name">sii.estudiante.se.search</field>
        <field name="model">sii.estudiante</field>
        <field name="arch" type="xml">
            <search string="Buscar Estudiante">
                <field name="no_control" string="No. Control"/>
                <field name="nombre" string="Nombre"/>
                <field name="apellido_paterno"/>
                <field name="id_carrera"/>
            </search>
        </field>
    </record>

    <record id="action_consulta_estudiante_se" model="ir.actions.act_window">
        <field name="name">Buscar Estudiante</field>
        <field name="res_model">sii.estudiante</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sii_estudiante_se_search"/>
        <field name="views" eval="[
            (ref('view_sii_estudiante_se_list'), 'list'),
            (ref('view_sii_estudiante_se_form'), 'form'),
        ]"/>
    </record>
</odoo>