<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ventana_liberacion_list" model="ir.ui.view">
        <field name="name">actividad.ventana.liberacion.list</field>
        <field name="model">actividad.ventana.liberacion</field>
        <field name="arch" type="xml">
            <list string="Ventanas de Liberación">
                <field name="periodo_id"/>
                <field name="fecha_inicio"/>
                <field name="fecha_fin"/>
                <field name="activa" widget="boolean"/>
                <field name="reporte_generado" widget="boolean"/>
            </list>
        </field>
    </record>

    <record id="view_ventana_liberacion_form" model="ir.ui.view">
        <field name="name">actividad.ventana.liberacion.form</field>
        <field name="model">actividad.ventana.liberacion</field>
        <field name="arch" type="xml">
            <form string="Ventana de Liberación">
                <header>
                    <button name="action_generar_reporte"
                            string="Generar Reporte de Liberados"
                            type="object" class="btn-success"
                            invisible="reporte_generado or activa"
                            confirm="¿Generar el reporte Excel de estudiantes liberados? Esta acción no se puede deshacer."/>
                </header>
                <sheet>
                    <div class="alert alert-success" role="alert"
                         invisible="not activa">
                        <i class="fa fa-calendar-check-o me-1"/>
                        <strong>Ventana activa</strong> — los estudiantes pueden enviar solicitudes.
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="not reporte_generado">
                        <i class="fa fa-file-excel-o me-1"/>
                        Reporte generado:
                        <field name="reporte_attachment_id" nolabel="1" readonly="1"/>
                    </div>
                    <group>
                        <field name="periodo_id"
                               options="{'no_create': True, 'no_quick_create': True}"/>
                        <field name="fecha_inicio"/>
                        <field name="fecha_fin"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ventana_liberacion" model="ir.actions.act_window">
        <field name="name">Ventanas de Liberación</field>
        <field name="res_model">actividad.ventana.liberacion</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ── SE-04SC: Historial de Reportes de Estudiantes Liberados ───────── -->

    <record id="view_historial_reportes_list" model="ir.ui.view">
        <field name="name">actividad.ventana.liberacion.historial.list</field>
        <field name="model">actividad.ventana.liberacion</field>
        <field name="arch" type="xml">
            <list string="Historial de Reportes" create="0" edit="0" delete="0"
                  default_order="fecha_fin desc">
                <field name="periodo_id" string="Periodo Escolar"/>
                <field name="fecha_inicio" string="Inicio de Ventana"/>
                <field name="fecha_fin" string="Cierre de Ventana"/>
                <field name="reporte_attachment_id" string="Archivo"
                       widget="many2one" readonly="1"/>
                <button name="action_descargar_reporte"
                        string="Descargar"
                        type="object"
                        icon="fa-download"
                        class="btn-sm btn-primary"/>
            </list>
        </field>
    </record>

    <record id="action_historial_reportes_se" model="ir.actions.act_window">
        <field name="name">Historial de Reportes</field>
        <field name="res_model">actividad.ventana.liberacion</field>
        <field name="view_mode">list</field>
        <field name="domain">[('reporte_generado', '=', True)]</field>
        <field name="views" eval="[
            (ref('view_historial_reportes_list'), 'list'),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aún no se han generado reportes de estudiantes liberados.
            </p>
            <p>
                Los reportes se generan desde <b>Ventanas de Evaluación</b>
                una vez que todas las solicitudes han sido evaluadas.
            </p>
        </field>
    </record>

</odoo>
