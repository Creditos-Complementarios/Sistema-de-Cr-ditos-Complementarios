<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- VISTAS — priority=100 para nunca ganar como default          -->
    <!-- ============================================================ -->

    <record id="view_act_alumno_form" model="ir.ui.view">
        <field name="name">actividad.complementaria.alumno.form</field>
        <field name="model">actividad.complementaria</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Actividad Complementaria"
                  create="0" edit="0" delete="0">
                <header>
                    <button name="action_inscribirse" string="Inscribirse"
                            type="object" class="btn-primary"
                            invisible="alumno_inscrito
                                       or estado_code != 'pendiente_inicio'
                                       or cupos_disponibles == 0"/>
                    <button name="action_darse_de_baja" string="Dar de Baja"
                            type="object" class="btn-danger"
                            invisible="not alumno_inscrito
                                       or estado_code == 'finalizada'"/>
                    <field name="estado_barra" widget="statusbar"
                           statusbar_visible="pendiente_inicio,en_curso,finalizada"
                           readonly="1"/>
                    <button name="action_abrir_evidencia"
                            string="Subir Evidencia"
                            type="object" class="btn-secondary"
                            invisible="not alumno_inscrito
                                       or not evidence_enabled
                                       or estado_code != 'finalizada'"/>
                </header>
                <sheet>
                    <field name="alumno_inscrito" invisible="1"/>
                    <field name="cupos_disponibles" invisible="1"/>
                    <field name="evidence_enabled" invisible="1"/>
                    <div class="alert alert-success" role="alert"
                         invisible="not alumno_inscrito">
                        <i class="fa fa-check me-1"/> Estás inscrito en esta actividad.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="cupos_disponibles != 0 or cupo_ilimitado">
                        <i class="fa fa-exclamation-triangle me-1"/>
                        No hay cupos disponibles.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Información General">
                            <field name="tipo_actividad_id" readonly="1"/>
                            <field name="periodo" readonly="1"/>
                            <field name="jefe_departamento_id"
                                   string="Departamento (JD)" readonly="1"/>
                            <field name="responsable_actividad_id" readonly="1"/>
                            <field name="creditos" readonly="1"/>
                        </group>
                        <group string="Fechas y Duración">
                            <field name="fecha_inicio" readonly="1"/>
                            <field name="fecha_fin" readonly="1"/>
                            <field name="cantidad_horas" readonly="1"/>
                            <field name="horario" readonly="1"/>
                            <field name="cupos_disponibles" readonly="1"
                                   invisible="cupo_ilimitado"/>
                            <field name="cupo_ilimitado" readonly="1"/>
                            <field name="constancias_firmadas" string="Constancia"/>
                        </group>
                    </group>
                    <group string="Descripción">
                        <field name="descripcion" nolabel="1"
                               colspan="2" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_act_alumno_catalogo_list" model="ir.ui.view">
        <field name="name">actividad.complementaria.alumno.catalogo.list</field>
        <field name="model">actividad.complementaria</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Catálogo de Actividades"
                  create="0" edit="0" delete="0">
                <field name="name" string="Actividad"/>
                <field name="tipo_actividad_id" string="Tipo"/>
                <field name="fecha_inicio"/>
                <field name="fecha_fin"/>
                <field name="creditos"/>
                <field name="cupos_disponibles" string="Cupos Disp."
                       invisible="cupo_ilimitado"/>
                <field name="cupo_ilimitado" column_invisible="1"/>
                <field name="estado_id" widget="badge"
                    decoration-info="estado_code == 'pendiente_inicio'"
                    decoration-success="estado_code == 'en_curso'"/>
                <field name="estado_code" column_invisible="1"/>
                <field name="constancias_firmadas" string="Constancia"/>
            </list>
        </field>
    </record>

    <record id="view_act_alumno_inscripciones_list" model="ir.ui.view">
        <field name="name">actividad.complementaria.alumno.inscripciones.list</field>
        <field name="model">actividad.complementaria</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Mis Inscripciones"
                  create="0" edit="0" delete="0">
                <field name="name" string="Actividad"/>
                <field name="tipo_actividad_id" string="Tipo"/>
                <field name="fecha_inicio"/>
                <field name="fecha_fin"/>
                <field name="creditos"/>
                <field name="estado_id" widget="badge"
                    decoration-info="estado_code == 'pendiente_inicio'"
                    decoration-success="estado_code == 'en_curso'"
                    decoration-muted="estado_code == 'finalizada'"/>
                <field name="constancias_firmadas" string="Constancia"/>
                <field name="estado_code" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_act_alumno_expediente_list" model="ir.ui.view">
        <field name="name">actividad.complementaria.alumno.expediente.list</field>
        <field name="model">actividad.complementaria</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Mis Constancias"
                  create="0" edit="0" delete="0">
                <field name="name" string="Actividad"/>
                <field name="tipo_actividad_id" string="Tipo"/>
                <field name="periodo"/>
                <field name="creditos"/>
                <field name="responsable_actividad_id" string="Responsable"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ACCIONES                                                     -->
    <!-- Sin views eval. La vinculación se hace mediante registros    -->
    <!-- explícitos de ir.actions.act_window.view — el campo          -->
    <!-- almacenado real del que views es computado.                  -->
    <!-- ============================================================ -->

    <record id="action_catalogo_alumno" model="ir.actions.act_window">
        <field name="name">Catálogo de Actividades</field>
        <field name="res_model">actividad.complementaria</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('en_catalogo', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay actividades disponibles en este momento.
            </p>
        </field>
    </record>
    <record id="action_catalogo_alumno_list"
            model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_act_alumno_catalogo_list"/>
        <field name="act_window_id" ref="action_catalogo_alumno"/>
    </record>
    <record id="action_catalogo_alumno_form"
            model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_act_alumno_form"/>
        <field name="act_window_id" ref="action_catalogo_alumno"/>
    </record>

    <record id="action_mis_inscripciones_alumno" model="ir.actions.act_window">
        <field name="name">Mis Inscripciones</field>
        <field name="res_model">actividad.complementaria</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[
            ('alumno_ids', 'in', [uid]),
            ('en_catalogo', '=', True),
            ('estado_code', 'in', ['pendiente_inicio', 'en_curso', 'finalizada']),
        ]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No estás inscrito a ninguna actividad todavía.
            </p>
        </field>
    </record>
    <record id="action_inscripciones_alumno_list"
            model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_act_alumno_inscripciones_list"/>
        <field name="act_window_id" ref="action_mis_inscripciones_alumno"/>
    </record>
    <record id="action_inscripciones_alumno_form"
            model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_act_alumno_form"/>
        <field name="act_window_id" ref="action_mis_inscripciones_alumno"/>
    </record>

    <record id="action_expediente_alumno" model="ir.actions.act_window">
        <field name="name">Mis Constancias</field>
        <field name="res_model">actividad.complementaria</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[
            ('alumno_ids', 'in', [uid]),
            ('constancias_firmadas', '=', True),
        ]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aún no tienes constancias firmadas.
            </p>
        </field>
    </record>
    <record id="action_expediente_alumno_list"
            model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_act_alumno_expediente_list"/>
        <field name="act_window_id" ref="action_expediente_alumno"/>
    </record>
    <record id="action_expediente_alumno_form"
            model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_act_alumno_form"/>
        <field name="act_window_id" ref="action_expediente_alumno"/>
    </record>

    <record id="action_solicitud_liberacion_alumno" model="ir.actions.act_window">
        <field name="name">Solicitud de Liberación</field>
        <field name="res_model">actividad.solicitud.liberacion</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('estudiante_id', '=', uid)]</field>
        <field name="context">{'default_estudiante_id': uid}</field>
    </record>

    <!-- ============================================================ -->
    <!-- WIZARD EVIDENCIA                                             -->
    <!-- ============================================================ -->

    <record id="view_wizard_evidencia_form" model="ir.ui.view">
        <field name="name">actividad.wizard.evidencia.form</field>
        <field name="model">actividad.wizard.evidencia</field>
        <field name="arch" type="xml">
            <form string="Subir Evidencia de Participación">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        El archivo quedará adjunto a la actividad y visible
                        para el Responsable de Actividad.
                    </div>
                    <group>
                        <field name="actividad_id" readonly="1"/>
                        <field name="descripcion"
                               placeholder="Ej: Fotografía de participación en sesión 3"/>
                        <field name="archivo" filename="archivo_nombre"/>
                        <field name="archivo_nombre" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_subir" string="Subir"
                            type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>