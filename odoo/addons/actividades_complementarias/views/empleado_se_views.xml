<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_empleado_permiso_se_search" model="ir.ui.view">
        <field name="name">actividad.empleado.permiso.se.search</field>
        <field name="model">actividad.empleado.permiso.se</field>
        <field name="arch" type="xml">
            <search string="Buscar Personal SE">
                <field name="user_id" string="Nombre"
                    filter_domain="[('user_id.name', 'ilike', self)]"/>
                <field name="no_empleado" string="No. Empleado"
                    filter_domain="[('no_empleado', 'ilike', self)]"/>
            </search>
        </field>
    </record>

    <record id="view_empleado_permiso_se_list" model="ir.ui.view">
        <field name="name">actividad.empleado.permiso.se.list</field>
        <field name="model">actividad.empleado.permiso.se</field>
        <field name="arch" type="xml">
            <list string="Personal de Servicios Escolares" create="0" delete="0">
                <field name="user_id" string="Empleado"/>
                <field name="no_empleado" string="No. Empleado"/>
                <field name="perm_aprobar_solicitudes" widget="boolean" readonly="1"/>
                <field name="perm_establecer_fechas" widget="boolean" readonly="1"/>
                <field name="perm_generar_reporte" widget="boolean" readonly="1"/>
                <field name="fecha_ultimo_uso" string="Último Uso"/>
                <button name="action_guardar_permisos" string="Editar Permisos"
                        type="object" icon="fa-pencil" class="btn-sm btn-secondary"/>
            </list>
        </field>
    </record>

    <record id="view_empleado_permiso_se_form" model="ir.ui.view">
        <field name="name">actividad.empleado.permiso.se.form</field>
        <field name="model">actividad.empleado.permiso.se</field>
        <field name="arch" type="xml">
            <form string="Permisos de Personal SE">
                <header>
                    <button name="action_guardar_permisos" string="Editar Permisos"
                            type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <group string="Datos del Empleado">
                        <field name="user_id" readonly="1"/>
                        <field name="no_empleado" readonly="1"/>
                        <field name="fecha_ultimo_uso" readonly="1"/>
                    </group>
                    <group string="Permisos Delegados">
                        <field name="perm_aprobar_solicitudes" readonly="1"/>
                        <field name="perm_establecer_fechas" readonly="1"/>
                        <field name="perm_generar_reporte" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Wizard de permisos SE -->
    <record id="view_wizard_guardar_permisos_se_form" model="ir.ui.view">
        <field name="name">actividad.wizard.guardar.permisos.se.form</field>
        <field name="model">actividad.wizard.guardar.permisos.se</field>
        <field name="arch" type="xml">
            <form string="Modificar Permisos SE">
                <sheet>
                    <field name="permiso_id" invisible="1"/>
                    <group string="Permisos Delegados">
                        <field name="perm_aprobar_solicitudes"/>
                        <field name="perm_establecer_fechas"/>
                        <field name="perm_generar_reporte"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirmar" string="Confirmar cambios"
                            type="object" class="btn-primary"
                            confirm="¿Confirmar los cambios en los permisos?"/>
                    <button name="action_cancelar" string="Cancelar"
                            type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_empleado_permiso_se" model="ir.actions.act_window">
        <field name="name">Gestión de Personal SE</field>
        <field name="res_model">actividad.empleado.permiso.se</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_empleado_permiso_se_search"/>
    </record>

    <record id="action_wizard_guardar_permisos_se" model="ir.actions.act_window">
        <field name="name">Modificar Permisos SE</field>
        <field name="res_model">actividad.wizard.guardar.permisos.se</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
